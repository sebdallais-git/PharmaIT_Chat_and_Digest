{
  "name": "pharma-llm",
  "version": "1.0.0",
  "description": "Pharma chatbot powered by Ollama with RAG",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "./scripts/start-services.sh",
    "dev:node": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:hermes-plugin": "python3 -m unittest discover -s hermes/tests -v",
    "watchlist": "tsx scripts/watchlist.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^6.0.1",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "undici": "^6.23.0",
    "whisper-node": "^1.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
