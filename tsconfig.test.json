{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "isolatedModules": true
  },
  "include": [
    "src/**/*",
    "__tests__/**/*",
    "scripts/lib/**/*",
    "scripts/reindex-stack.ts",
    "scripts/remove-source.ts",
